venv/
.venv-twotower/
__pycache__/
*.py[cod]
dev/
*.zip

# Model checkpoints and weights
saved/
*.pth
*.pt
*.ckpt
*.checkpoint

# Training logs
log/
logs/
log_tensorboard/

# RecBole outputs
results/recbole/

# LibRecommender outputs (TwoTower checkpoints/npz can be tens/hundreds of MB each)
results/librecommender/

# Elliot outputs written to external/results/ (generated, not source)
external/results/

data/raw/*
data/processed/*
data/recbole/
results/elliot/*/recs/
results/elliot/*/logs/

*.csv
*.tsv

!data/raw/.gitkeep
!data/processed/.gitkeep
!data/reports/.gitkeep
!data/reports/*.csv
!results/elliot/*/performance/*.tsv


# Third-party LibRecommender source — installed separately
external/librecommender/

# Ad-hoc backup folders created during rerun cleanups (large model/data dumps)
_backup*/

# Office lock files (created while a file is open in Excel/Word)
~$*